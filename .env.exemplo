# Postgres / backend
POSTGRES_USER=usuario
POSTGRES_PASSWORD=senha
POSTGRES_DB=banco

# --- SSO ---
# O IP fixo do servidor. Mantido em dia por infra/scripts/sync_host_ip.py;
# edite no infra/.env, não aqui.
HOST_IP=

# Conta mestra: UM email, o mesmo nos tres sistemas, que entra como
# administrador aqui sem depender de grupo nem de script de promocao.
# Preenchido por `python infra/scripts/sync_host_ip.py` — nao edite a mao.
ADMIN_MESTRE_EMAIL=

# Segredo do client `despesa-web` no Keycloak (o mesmo valor do infra/.env).
DESPESA_CLIENT_SECRET=

# Cifra o cookie de sessão do frontend (JWE). Mínimo 32 caracteres.
# Gere com: openssl rand -hex 32
DESPESA_SESSION_SECRET=

# Backup automático
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Frontend — o navegador chama /api na mesma origem.
INTERNAL_API_BASE_URL=http://backend:8000
